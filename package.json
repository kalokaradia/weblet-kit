{
  "name": "weblet-kit",
  "version": "2.2.0",
  "description": "A lightweight, dependency-free JavaScript utility toolkit for everyday web development.",
  "type": "module",
  "license": "MIT",
  "author": "kalokaradia",
  "repository": {
    "type": "git",
    "url": "https://github.com/kalokaradia/weblet-kit.git"
  },
  "keywords": [
    "javascript",
    "typescript",
    "utility",
    "toolkit",
    "helpers",
    "validators",
    "esm",
    "dependency-free",
    "web-development"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/weblet-kit.es.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc",
    "build:vite": "vite build",
    "build:types": "tsc",
    "test": "npm run build && node --test tests/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
